// 253Pay — schéma de base de données
// PHASE 1 : uniquement la connexion. Les tables arrivent en PHASE 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PHASE 2 : users, wallets, ledger_accounts, ledger_entries, transactions...
