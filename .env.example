# =====================================================
# 253Pay — variables d'environnement
# Copiez ce fichier en .env :  cp .env.example .env
# Le fichier .env n'est JAMAIS commité dans Git.
# =====================================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL (utilisé par Docker ET par le backend) ---
POSTGRES_USER=pay253
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=pay253
POSTGRES_PORT=5433

# Attention : port 5433 côté machine, 5432 dans le conteneur
DATABASE_URL=postgresql://pay253:dev_password_change_me@localhost:5433/pay253?schema=public

# --- Redis ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- pgAdmin (interface web pour voir la base) ---
PGADMIN_EMAIL=admin@253pay.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- JWT (phase 3) ---
# Générer avec : openssl rand -hex 32
JWT_ACCESS_SECRET=remplacez_moi_par_une_chaine_aleatoire_de_64_caracteres_minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=remplacez_moi_aussi_par_une_autre_chaine_aleatoire_differente
JWT_REFRESH_TTL=30d

# --- Authentification : OTP et PIN (phase 3) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# Tant qu'aucun opérateur SMS n'est branché, l'OTP est renvoyé dans la réponse
# HTTP pour permettre de développer. L'application REFUSE de démarrer si cette
# valeur est à true avec NODE_ENV=production.
OTP_EXPOSE_IN_RESPONSE=true

PIN_LENGTH=4
PIN_MAX_ATTEMPTS=3

# --- Argent ---
DEFAULT_CURRENCY=DJF
CURRENCY_SCALE=2

# --- Limitation de débit ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
