# ============================================
# ENVIRONNEMENT VARIABLES - 253PAY
# ============================================

# NODE
NODE_ENV=development
APP_NAME=253Pay-API
APP_PORT=3000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=253pay_user
DATABASE_PASSWORD=secure_password_here
DATABASE_NAME=253pay_db
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_chars_long
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_long
JWT_REFRESH_EXPIRATION=604800

# ============================================
# OTP
# ============================================
OTP_LENGTH=6
OTP_EXPIRATION=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=1

# ============================================
# CURRENCIES & DEFAULTS
# ============================================
DEFAULT_CURRENCY=DJF
SANDBOX_MODE=true

# ============================================
# FIREBASE (Notifications)
# ============================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_PRETTY=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=10
PIN_ATTEMPTS_MAX=3
PIN_LOCK_DURATION_MINUTES=30

# ============================================
# PAYMENT PROVIDERS (Mock for now)
# ============================================
PAYMENT_PROVIDER_DEFAULT=mock
MOCK_PROVIDER_ENABLED=true

# ============================================
# ADMIN
# ============================================
ADMIN_PHONE=+252700000000
ADMIN_PASSWORD=change_me_immediately
ADMIN_EMAIL=admin@253pay.dj
